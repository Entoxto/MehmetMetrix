{
  "name": "mehmet-metrics",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict-check.json",
    "test": "vitest run",
    "test:excel": "python Excel/test_parser_logic.py",
    "test:images": "python scripts/test_convert_to_webp.py",
    "validate:data": "python Excel/validate_generated_data.py",
    "validate:images": "node scripts/validate_catalog_images.mjs",
    "publish:data": "node scripts/publish_data.mjs",
    "publish:data:dry-run": "node scripts/publish_data.mjs --dry-run",
    "preflight:fast": "node scripts/preflight.mjs --fast",
    "preflight": "node scripts/preflight.mjs",
    "build:full": "npm run preflight"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.6.3",
    "vitest": "4.1.10"
  }
}
